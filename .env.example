# Copy this file to .env and fill in your key, or enter the key in the app sidebar.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the Gemini model. Defaults to gemini-2.5-flash-lite
# (best free-tier rate limits). Example alternative: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: enables the Politician Trading tab (congressional trades).
# Free key at https://finnhub.io/register
FINNHUB_API_KEY=your-finnhub-api-key-here
